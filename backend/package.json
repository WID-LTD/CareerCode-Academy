{
  "name": "careercode-academy-backend",
  "version": "1.0.0",
  "description": "CareerCode Academy Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "cross-env NODE_NO_WARNINGS=1 tsx watch --require dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx --require dotenv/config src/seed-courses.ts",
    "seed:admin": "tsx --require dotenv/config src/seed-admin.ts",
    "seed:exam": "tsx --require dotenv/config src/seed-exam-questions.ts",
    "seed:schools": "tsx --require dotenv/config src/seed-schools.ts",
    "seed:career-goals": "tsx --require dotenv/config src/seed-career-goals.ts",
    "seed:cert": "tsx --require dotenv/config src/seed-certificate-assets.ts",
    "seed:board": "tsx --require dotenv/config src/seed-board.ts",
    "seed:yt": "tsx --require dotenv/config src/seed-youtube-videos.ts",
    "seed:yt:urls": "tsx --require dotenv/config src/seed-youtube-videos.ts --urls-only",
    "seed:yt:refs": "tsx --require dotenv/config src/seed-youtube-references.ts",
    "seed:yt:scrape": "tsx --require dotenv/config src/seed-scrape-course-videos.ts",
    "seed:yt:scrape:dry": "tsx --require dotenv/config src/seed-scrape-course-videos.ts --dry-run",
    "seed:coursera": "tsx --require dotenv/config src/seed-coursera-refs.ts",
    "generate-videos": "tsx --require dotenv/config src/generate-lesson-videos.ts",
    "lesson:reference": "tsx --require dotenv/config src/lesson-pipeline/fetch-reference.ts",
    "lesson:script": "tsx --require dotenv/config src/lesson-pipeline/generate-script.ts",
    "lesson:voiceover": "tsx --require dotenv/config src/lesson-pipeline/generate-voiceover.ts",
    "lesson:scenes": "tsx --require dotenv/config src/lesson-pipeline/generate-scenes.ts",
    "lesson:render": "tsx --require dotenv/config src/lesson-pipeline/render-lesson-video.ts",
    "lesson:migrate": "tsx --require dotenv/config src/lesson-pipeline/migrate-existing-lessons.ts",
    "migrate": "tsx --require dotenv/config src/migrate.ts",
    "migrate:sql": "tsx --require dotenv/config src/scripts/migrate-sql.ts",
    "migrate:s3": "tsx --require dotenv/config src/migrate-local-to-s3.ts",
    "migrate:videos": "tsx --require dotenv/config src/migrate-local-videos-to-s3.ts",
    "migrate:placeholders": "tsx --require dotenv/config src/link-unmatched-videos.ts",
    "lint": "eslint src --ext .ts",
    "test": "node --experimental-test-module-mocks --import tsx --test src/__tests__/*.test.mjs",
    "test:env": "tsx --require dotenv/config src/scripts/validateEnv.ts",
    "env:check": "tsx --require dotenv/config src/scripts/validateEnv.ts",
    "dev:env": "npm run test:env && npm run dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1070.0",
    "@google/generative-ai": "^0.21.0",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.5",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
